@page
@model Path_Green.web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard-page">

    <div class="admin-dashboard-header">
        <h1>Admin Dashboard</h1>
        <p>Monitor orders, inventory, and operational activity.</p>
    </div>

    <div class="admin-management-grid">

        <a asp-page="/Orders/Index" class="admin-management-card admin-card-link">
            <div>
                <h2>Manage Orders</h2>
                <p>Review student requests, update statuses, and view order details.</p>
            </div>
            <span class="admin-card-button">Open Orders</span>
        </a>

        <a asp-page="/Products/Index" class="admin-management-card admin-card-link">
            <div>
                <h2>Manage Products</h2>
                <p>Add, edit, and organize products by category and subcategory.</p>
            </div>
            <span class="admin-card-button">Open Products</span>
        </a>

        <a asp-page="/Inventories/Index" class="admin-management-card admin-card-link">
            <div>
                <h2>Manage Inventory</h2>
                <p>Monitor stock levels, low-stock items, and out-of-stock items.</p>
            </div>
            <span class="admin-card-button">Open Inventory</span>
        </a>

        <a asp-page="/Schools/Index" class="admin-management-card admin-card-link">
            <div>
                <h2>Manage Schools</h2>
                <p>Add and update schools shown in the student order form.</p>
            </div>
            <span class="admin-card-button">Open Schools</span>
        </a>

    </div>

    <div class="admin-status-grid">

        <div class="admin-stat-card total">
            <div class="admin-stat-label">Total Orders</div>
            <div class="admin-stat-number">@Model.TotalOrders</div>
        </div>

        <div class="admin-stat-card pending">
            <div class="admin-stat-label">Pending</div>
            <div class="admin-stat-number">@Model.PendingOrders</div>
        </div>

        <div class="admin-stat-card approved">
            <div class="admin-stat-label">Approved</div>
            <div class="admin-stat-number">@Model.ApprovedOrders</div>
        </div>

        <div class="admin-stat-card rejected">
            <div class="admin-stat-label">Rejected</div>
            <div class="admin-stat-number">@Model.RejectedOrders</div>
        </div>

        <div class="admin-stat-card delivered">
            <div class="admin-stat-label">Delivered</div>
            <div class="admin-stat-number">@Model.DeliveredOrders</div>
        </div>

    </div>

    <div class="admin-summary-grid">

        <div class="admin-summary-card">
            <h3>Total Products</h3>
            <div class="summary-number">@Model.TotalProducts</div>
            <p>Products available in the system.</p>
        </div>

        <div class="admin-summary-card">
            <h3>Low Stock Items</h3>
            <div class="summary-number text-warning">@Model.LowStockItems.Count</div>
            <p>Items at or below reorder level.</p>
        </div>

        <div class="admin-summary-card">
            <h3>Out of Stock Items</h3>
            <div class="summary-number text-danger">@Model.OutOfStockItems</div>
            <p>Items with no available quantity.</p>
        </div>

    </div>

    <h2 class="admin-recent-title">Recent Orders</h2>

    <div class="admin-recent-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td>@order.OrderID</td>
                        <td>
                            @if (order?.OrderStatus?.StatusName == "Pending")
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (order?.OrderStatus?.StatusName == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (order?.OrderStatus?.StatusName == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else if (order?.OrderStatus?.StatusName == "Delivered")
                            {
                                <span class="badge bg-dark">Delivered</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.!StatusName</span>
                            }
                        </td>
                        <td>@order!.OrderDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<style>

    .dashboard-card {
        transition: transform 0.2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
        }

</style>